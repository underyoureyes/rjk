# RJK Reporting Framework — environment variables
# Copy to .env and fill in values

# Set to false to connect to a real database via pyodbc
MOCK_MODE=true

# ODBC connection string (only used when MOCK_MODE=false)
# Example: Driver={ODBC Driver 17 for SQL Server};Server=myserver;Database=mydb;UID=user;PWD=pass
DB_CONN_STRING=

# Path to the reports root directory (default: reports/)
REPORTS_ROOT=reports

# Path to the SQLite audit database (default: data/audit.db)
AUDIT_DB_PATH=data/audit.db

# MySQL connection URL for persisting aggregation results (optional)
# Format: mysql+pymysql://user:password@host:port/database
# Example: mysql+pymysql://rjk_user:secret@localhost:3306/rjk_aggs
# Leave blank to disable MySQL persistence (JSON will be used instead)
MYSQL_URL=
